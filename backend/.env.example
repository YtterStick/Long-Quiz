# Database
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/longquiz

# JWT  (REQUIRED: 32+ random chars, app refuses to start otherwise)
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Drive
GDRIVE_FOLDER_ID=your-google-drive-folder-id
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json

# CORS
FRONTEND_URL=http://localhost:3000

# ─── Security ────────────────────────────────────────────────
# Initial admin account, created on startup only if the username doesn't exist.
# Password: 12+ chars with letters and numbers. Remove both after first login.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Fernet key for encrypting exam answer keys at rest. Use the SAME key everywhere
# that connects to the same database. Never change it without key rotation
# (comma-separate: NEW_KEY,OLD_KEY).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Swagger /docs (keep false in production)
ENABLE_API_DOCS=false
